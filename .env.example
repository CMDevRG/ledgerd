# Copy to .env (or run `make env`, which fills in random secrets).
# .env is git-ignored. Never commit real credentials.

# API key clients must send as `Authorization: Bearer <key>` (at least 16 characters).
LEDGERD_API_KEY=change-me-to-a-long-random-string

# PostgreSQL passwords. Three roles exist:
#   superuser      bootstraps the database (used only by the postgres container)
#   ledgerd_owner  owns the schema, runs migrations
#   ledgerd_app    used by the running API; cannot alter or delete history
POSTGRES_SUPERUSER_PASSWORD=change-me
LEDGERD_OWNER_PASSWORD=change-me
LEDGERD_APP_PASSWORD=change-me

# Host ports (both are bound to 127.0.0.1 only). Change them if they clash with
# something else on your machine. The PostgreSQL port is deliberately below 49152:
# on Windows, Hyper-V/WinNAT reserve random ranges inside the ephemeral range
# (49152-65535), and Docker Desktop then fails with "ports are not available".
LEDGERD_PORT=8085
LEDGERD_POSTGRES_PORT=15432
